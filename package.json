{
  "name": "@sergenkabakci/react-native-html-renderer",
  "version": "2.0.0",
  "description": "A performant HTML rendering library for React Native using native components",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "rm -rf lib",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src __tests__",
    "prepare": "bob build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test"
  },
  "keywords": [
    "react-native",
    "expo",
    "html",
    "parser",
    "renderer",
    "html-viewer",
    "html-to-native"
  ],
  "author": "Sergen Kabakci",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergenkabakci/react-native-html-renderer.git"
  },
  "bugs": {
    "url": "https://github.com/sergenkabakci/react-native-html-renderer/issues"
  },
  "homepage": "https://github.com/sergenkabakci/react-native-html-renderer#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.73.0"
  },
  "dependencies": {
    "htmlparser2": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.5.2",
    "react": "19.3.0",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}